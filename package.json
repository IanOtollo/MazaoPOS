{
  "name": "mazao-pos",
  "version": "1.0.0",
  "description": "Point of sale for a hardware shop: fast till, stock, suppliers, customers on credit, reports. Runs on the shop computer and keeps selling without internet.",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx server/smoke.test.ts",
    "build": "npm run build:web"
  },
  "keywords": [],
  "author": "IanOtollo",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fontsource-variable/jost": "^5.3.0",
    "convex": "^1.51.0",
    "fastify": "^5.12.8",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "private": true,
  "engines": {
    "node": ">=22.5"
  }
}
