# Copy this file to .env for local use. Never commit the real .env.

# ---- the screens (on Vercel: Project > Settings > Environment Variables) ----
# Where the server lives. Leave it empty when the screens and the server share one address
# (the shop computer, or local development). On Vercel it must be the server's https address.
VITE_API_URL=

# ---- the server (set on the machine that runs it) ----
PORT=4000
DB_PATH=data/pos.db
BACKUP_DIR=data/backups
# Web addresses allowed to use the server, comma separated. Empty means any.
# Example: https://mazaopos.vercel.app
CORS_ORIGIN=
